# Everything here is optional. With no keys the server runs on clearly-labelled
# synthetic data. Each key switches one capability from synthetic to live.
# Run the `provider_status` tool to see what is on.

# --- AliExpress Open Platform (official API) --------------------------------
# portals.aliexpress.com -> join affiliate programme -> create app
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=default

# If the gateway rejects your signature, flip these. Which pair your app key
# wants depends on when it was provisioned.
#   ALIEXPRESS_SIGN_METHOD:      sha256 | md5
#   ALIEXPRESS_TIMESTAMP_STYLE:  ms | datetime
ALIEXPRESS_SIGN_METHOD=sha256
ALIEXPRESS_TIMESTAMP_STYLE=ms
ALIEXPRESS_GATEWAY=https://api-sg.aliexpress.com/sync

# --- SerpApi: retail price benchmark + Google Trends -------------------------
# serpapi.com — 100 free searches/month.
# Without this, margin is an assumption rather than a measurement.
SERPAPI_KEY=

# --- Apify: Temu and Alibaba (neither has a public product API) --------------
# console.apify.com -> Settings -> API & Integrations
APIFY_TOKEN=
# Override if you prefer different actors:
# APIFY_ACTOR_ALIEXPRESS=scrapers_lat~aliexpress-scraper
# APIFY_ACTOR_TEMU=amit123~temu-products-scraper
# APIFY_ACTOR_ALIBABA=devcake~alibaba-ai-search

# --- Defaults ----------------------------------------------------------------
PRODUCT_SCOUT_MARKET=US
PRODUCT_SCOUT_CURRENCY=USD
PRODUCT_SCOUT_CACHE_TTL=21600
# PRODUCT_SCOUT_DATA_DIR=~/.product-scout
