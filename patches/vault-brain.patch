index 0000000..aaa3106
--- /dev/null
+++ b/load-config.js
@@ -0,0 +1,53 @@
+'use strict';
+// Single place that turns config.json into the CFG object every entrypoint uses.
+//
+// The tokens are credentials, so config.json is no longer tracked in git. A
+// fresh clone starts from config.example.json, and either value can be
+// overridden from the environment, which is what CI and the two-machine setup
+// use so a real token never has to sit on disk.
+const fs = require('fs');
+const path = require('path');
+
+const HERE = __dirname;
+const REAL = path.join(HERE, 'config.json');
+const EXAMPLE = path.join(HERE, 'config.example.json');
+const PLACEHOLDER = 'replace-me';
+
+function load() {
+  let file = REAL;
+  if (!fs.existsSync(file)) {
+    if (!fs.existsSync(EXAMPLE)) {
+      throw new Error(
+        'Vault Brain has no config.json and no config.example.json next to ' +
+        HERE + '. Copy config.example.json to config.json and put your ' +
+        'Obsidian Local REST API tokens in it.'
+      );
+    }
+    file = EXAMPLE;
+  }
+
+  let cfg;
+  try {
+    cfg = JSON.parse(fs.readFileSync(file, 'utf8'));
+  } catch (err) {
+    throw new Error('Could not read ' + file + ': ' + err.message);
+  }
+
+  cfg.upstream = cfg.upstream || {};
+  if (process.env.VAULT_BRAIN_TOKEN) cfg.token = process.env.VAULT_BRAIN_TOKEN;
+  if (process.env.VAULT_BRAIN_UPSTREAM_TOKEN) {
+    cfg.upstream.token = process.env.VAULT_BRAIN_UPSTREAM_TOKEN;
+  }
+  if (process.env.VAULT_BRAIN_VAULT_PATH) cfg.vaultPath = process.env.VAULT_BRAIN_VAULT_PATH;
+
+  if (!cfg.token || cfg.token === PLACEHOLDER) {
+    throw new Error(
+      'Vault Brain has no access token. Put the Obsidian Local REST API token ' +
+      'in config.json, or set VAULT_BRAIN_TOKEN. (Read it from Obsidian: ' +
+      'Settings -> Local REST API.)'
+    );
+  }
+  return cfg;
+}
+
+module.exports = load;
